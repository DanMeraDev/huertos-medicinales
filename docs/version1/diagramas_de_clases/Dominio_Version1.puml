@startuml Diagrama_Clases_Dominio_Huertos_Medicinales_V1
' ==========================================================
' MODELO DE DOMINIO - REPRESENTACIÓN CONCEPTUAL
' Sistema de Huertos Medicinales Comunitarios del Ecuador
' Versión 1.0 (MVP)
'
' Describe la realidad del negocio: qué conceptos existen en
' el huerto comunitario, cómo se relacionan entre sí y qué
' reglas los gobiernan. No incluye detalles técnicos de
' programación, persistencia, servicios ni infraestructura.
'
' Fuentes: docs/version1/MER.puml
'         docs/version1/casos_de_uso/CU_Version1.puml
' ==========================================================
!theme plain
hide circle
skinparam linetype ortho
skinparam roundcorner 6
skinparam shadowing false
skinparam defaultFontName "Segoe UI", "Helvetica", sans-serif
skinparam defaultFontSize 12

skinparam class {
    BackgroundColor #F8FBFE
    BorderColor #2980B9
    HeaderBackgroundColor #D4E6F1
    FontColor #0B172A
}
skinparam classAttribute {
    FontSize 11
}
skinparam package {
    BackgroundColor #F2F7FB
    BorderColor #5DADE2
    FontColor #154360
    FontStyle bold
}
skinparam note {
    BackgroundColor #FEF9E7
    BorderColor #B7950B
    FontColor #7D6608
}
skinparam stereotype {
    BackgroundColor #D4E6F1
    BorderColor #2980B9
    FontColor #154360
}

' ==========================================================
' 1. ORGANIZACIÓN COMUNITARIA
' ==========================================================
package "Organización comunitaria" {

    abstract class "Usuario" as Usuario {
        + nombre completo
        + identificación
        + fecha de nacimiento
        + género
        + correo
        + teléfono
        + activo : booleano
        + debe cambiar su clave : booleano
    }

    class "Responsable de comunidad" as Responsable
    class "Técnico MSP" as TecnicoMSP
    class "Técnico SIS" as TecnicoSIS

    class "Solicitud de creación de comunidad" as Solicitud {
        + nombre de la comunidad
        + tipo de organización : Tipo de organización
        + provincia
        + parroquia
        + dirección
        + latitud
        + longitud
        + altitud (msnm)
        + diseño principal : Diseño principal
        + subtipos solicitados
        + nombre del solicitante
        + cédula del solicitante
        + fecha de nacimiento del solicitante
        + género del solicitante
        + correo del solicitante
        + celular del solicitante
        + consentimiento de datos : booleano
        + estado : Estado de la solicitud
        + motivo del rechazo
        + fecha de la revisión
    }

    class "Estado de la solicitud" as EstadoSolicitud <<enumeracion>> {
        Pendiente
        Aprobada
        Rechazada
    }

    class "Comunidad" as Comunidad {
        + nombre
        + tipo de organización : Tipo de organización
        + provincia
        + parroquia
        + dirección
        + teléfono de contacto
        + correo de contacto
        + puntos acumulados
        + activa : booleano
    }

    class "Tipo de organización" as TipoOrganizacion <<enumeracion>> {
        Individual
        Familia
        Condominio
        Barrio
        Comité local
    }

    class "Miembro (voluntario)" as Miembro {
        + cédula
        + nombres
        + apellidos
        + fecha de nacimiento
        + género
        + teléfono
        + nivel : Nivel del miembro
        + puntos acumulados
        + consentimiento de datos : booleano
        + activo : booleano
    }

    class "Nivel del miembro" as NivelMiembro <<enumeracion>> {
        Aprendiz
        Oficial
        Maestro
    }

    class "Pertenencia a la comunidad" as Pertenencia {
        + fecha de ingreso
        + fecha de baja
        + motivo de la baja
        + activo en la comunidad : booleano
    }
}

' ==========================================================
' 2. HUERTO Y CULTIVO
' ==========================================================
package "Huerto y cultivo" {

    class "Huerto" as Huerto {
        + nombre
        + latitud
        + longitud
        + altitud (msnm)
        + orientación
        + área total (m²)
        + tipo de huerto : Tipo de huerto
        + diseño principal : Diseño principal
        + tipo de suelo : Tipo de suelo
        + fuente de agua : Fuente de agua
        + tipo de abono : Tipo de abono
        + tipo de cerca : Tipo de cerca
        + detalle de la cerca
        + puntos acumulados
        + activo : booleano
    }

    class "Subhuerto (zona de cultivo)" as Subhuerto {
        + nombre de la zona
        + subtipo : Subtipo de subhuerto
        + área (m²)
        + activo : booleano
    }

    class "Siembra" as Siembra {
        + cantidad sembrada
        + fecha de siembra
        + fase lunar de la siembra : Fase lunar
        + hubo alerta por altitud : booleano
        + estado del cultivo : Estado del cultivo
        + causa de la pérdida : Causa de la pérdida
        + observación de la pérdida
    }

    class "Estado del cultivo" as EstadoCultivo <<enumeracion>> {
        Sembrado
        En crecimiento
        Cosechado
        Perdido
    }

    class "Causa de la pérdida" as CausaFracaso <<enumeracion>> {
        Helada o clima extremo
        Plaga o enfermedad
        Sequía o falta de riego
        Suelo inadecuado
        Daño externo
        Caducidad o pudrición
    }
}

' ==========================================================
' 3. CATÁLOGOS OPERATIVOS DEL HUERTO
' ==========================================================
package "Catálogos operativos del huerto" {

    class "Tipo de huerto" as TipoHuerto <<enumeracion>> {
        Básico
        Integral
    }

    class "Diseño principal" as DisenoPrincipal <<enumeracion>> {
        En tierra
        Vertical
        Colgante
        En piso
    }

    class "Tipo de suelo" as TipoSuelo <<enumeracion>> {
        Arcilloso
        Limoso
        Arenoso
        Margoso
        Gredoso
        Pantanoso
    }

    class "Fuente de agua" as FuenteAgua <<enumeracion>> {
        Río
        Canal
        Goteo
        Vertiente de lluvia
        Grifo reposado
    }

    class "Tipo de abono" as TipoAbono <<enumeracion>> {
        Barbecho
        Restos vegetales
        Hojas con nitrógeno
        Compost
        Purín líquido
        Estiércol secado
    }

    class "Tipo de cerca" as TipoCerca <<enumeracion>> {
        Cerca viva
        Material natural
        Material reciclado
        Material metálico
        Convencional
    }

    class "Subtipo de subhuerto" as SubtipoSubhuerto <<enumeracion>> {
        Surcos Wachu
        Terrazas Anti
        Camellones Inka Wachu
        Vertical de pared
        Colgante de techo
        Macetas de piso
        Llantas recicladas
    }
}

' ==========================================================
' 4. CATÁLOGO DE PLANTAS Y BODEGA
' ==========================================================
package "Catálogo de plantas y bodega" {

    class "Planta" as Planta {
        + nombre común
        + nombre kichwa
        + nombre científico
        + familia botánica
        + cualidad térmica
        + ciclo de cultivo
        + origen
        + altitud mínima (msnm)
        + altitud máxima (msnm)
        + regiones de distribución
        + usos medicinales
        + preparación y dosificación
        + contraindicaciones
        + fotografía
        + activa : booleano
        + motivo de la baja
        + fecha de la baja
    }

    class "Categoría de uso medicinal" as CategoriaUso <<enumeracion>> {
        Antiespasmódica
        Antiinflamatoria
        Antioxidante
        Antiparasitaria
        Antipirética
        Astringente
        Cicatrizante
        Diurética
        Energética
        Depurativa
        Descongestionante
        Estimulante
        Expectorante
        Sedante
    }

    class "Lote de material vegetal" as Lote {
        + tipo de material : Tipo de material vegetal
        + cantidad disponible
        + unidad de medida : Unidad de medida
        + lote de origen
        + fecha de ingreso
        + activo : booleano
    }

    class "Tipo de material vegetal" as TipoMaterial <<enumeracion>> {
        Semillas
        Estacas
        Esquejes
        Plántulas
    }

    class "Unidad de medida" as UnidadMedida <<enumeracion>> {
        Unidades
        Gramos
        Manojos
    }

    class "Baja de material vegetal" as Baja {
        + cantidad dada de baja
        + causa
        + observación
        + fecha de la baja
    }
}

' ==========================================================
' 5. SABERES ANCESTRALES Y CALENDARIO LUNAR
' ==========================================================
package "Saberes ancestrales y calendario lunar" {

    class "Saber ancestral (hito)" as Saber {
        + orden del paso
        + código del hito
        + título
        + título en kichwa
        + categoría : Categoría del saber ancestral
        + fase lunar ideal : Fase lunar
        + horario energético
        + contenido educativo
        + ingredientes y herramientas
        + puntos base para la comunidad
        + nombre de la insignia oficial
    }

    class "Categoría del saber ancestral" as CategoriaSaber <<enumeracion>> {
        Preparación de tierra
        Abono natural
        Ritual de siembra
        Siembra señalética
        Cuidado y riego
        Ritual de cosecha
        Secado y empaquetado
    }

    class "Actividad ancestral (minka)" as ActividadAncestral {
        + fecha de realización
        + fase lunar de la ejecución : Fase lunar
        + bitácora (descripción)
        + número de intento
        + estado de verificación : Estado de verificación
        + observación del MSP
        + puntos a acreditar a la comunidad
        + fecha de la verificación
    }

    class "Evidencia de la actividad" as Evidencia {
        + fotografía
        + videoregistro
    }

    class "Estado de verificación" as EstadoVerificacion <<enumeracion>> {
        Pendiente
        Observada para corregir
        Aprobada
        Rechazada definitivamente
    }

    class "Participante de la actividad ancestral" as Participante {
        + horas trabajadas
        + puntos acreditados
    }

    class "Calendario lunar" as CalendarioLunar

    class "Fase lunar" as FaseLunar {
        + nombre en kichwa
        + nombre en español
        + fecha de inicio
        + fecha de fin
        + prácticas recomendadas
        + consejo del Kinti
    }
}

' ==========================================================
' 6. GAMIFICACIÓN Y RECONOCIMIENTO
' ==========================================================
package "Gamificación y reconocimiento" {

    class "Actividad cotidiana de la comunidad" as ActividadCotidiana {
        + nombre
        + categoría : Categoría de la actividad cotidiana
        + puntos por hora
        + activa : booleano
    }

    class "Categoría de la actividad cotidiana" as CategoriaActividad <<enumeracion>> {
        Limpieza y deshierbe
        Riego
        Abono y compost
        Replante y aporque
        Cuidado general
    }

    class "Registro de actividad de miembro" as RegistroActividad {
        + fecha de la actividad
        + horas trabajadas
        + puntos otorgados
        + observación
    }

    class "Talento comunitario" as Talento {
        + nombre de la insignia
        + descripción
        + meta de repeticiones
        + activo : booleano
    }

    abstract class "Insignia" as Insignia {
        + nombre
        + descripción
        + fecha de obtención
    }

    class "Insignia oficial del saber ancestral" as InsigniaOficial

    class "Medalla de talento comunitario" as MedallaTalento
}

