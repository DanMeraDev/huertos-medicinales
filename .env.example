# Copia este archivo como .env y ajusta los valores si hace falta.
# Lo leen docker-compose, el back en local (perfil dev) y el front en local (npm run dev).

# Perfil de Spring Boot del API: dev o prod.
SPRING_PROFILES_ACTIVE=dev
DB_NAME=huertos
DB_USER=huertos
DB_PASSWORD=huertos
DB_ROOT_PASSWORD=root
DB_PORT=3306
API_PORT=8080
WEB_PORT=5173

# Clave para firmar los tokens: mínimo 32 caracteres. Duración del token en minutos.
JWT_SECRET=clave-de-desarrollo-solo-para-uso-local
JWT_EXPIRACION_MINUTOS=1440

# Primer TECNICO_SIS, creado al arrancar si no hay ninguno. Si quedan vacías, no se crea.
# La fecha de nacimiento va en formato AAAA-MM-DD.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FECHA_NACIMIENTO=

# Servidor SMTP para enviar las credenciales o el rechazo de una solicitud de comunidad.
# Si no hay servidor, la solicitud se resuelve igual y la falla queda en el log del API.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-responder@huertos.gob.ec
# Dirección del front que va en el enlace del correo.
FRONTEND_URL=http://localhost:5173
